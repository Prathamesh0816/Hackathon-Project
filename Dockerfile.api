FROM python:3.12-slim

WORKDIR /app

# Install system dependencies for sentence-transformers / chromadb
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc g++ && \
    rm -rf /var/lib/apt/lists/*

# Install backend dependencies (including LangChain/LangGraph)
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend code
COPY backend/ ./backend/
# Copy database/ for vectordb
COPY database/ ./database/
# Copy data files
COPY backend/data/ ./backend/data/

WORKDIR /app/backend

EXPOSE 8000

# LangChain ChatOllama uses the base Ollama URL (without /api/generate)
# agents_langchain.py strips /api/generate if present for backward compat
ENV OLLAMA_URL=http://ollama:11434

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
